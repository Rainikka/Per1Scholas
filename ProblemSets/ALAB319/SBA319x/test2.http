
################ USER ROUTES ################
#############################################

# GET ALL USERS 
# Exmaple: Get All Users
#GET http://localhost:3000/api/users

# GET USER BY ID
# Example : Get User Maxine Shaw
# GET http://localhost:3000/api/users/6818523ea14e85e2dff7676a

# UPDATE USER BY ID
# Example: Update Name of User Synclair James
# PUT http://localhost:3000/api/users/6818523ea14e85e2dff7676f
# Content-Type: application/json
# {
#   "user": "Synclaire James-Jones",
#   "age": 29
# }

# DELETE USER BY ID
# Example: Delete User Maxine Shaw
# DELETE http://localhost:3000/api/users/6818523ea14e85e2dff7676a
# Content-Type: application/json

# ADD NEW USERS
# Example: Add New User
# POST http://localhost:3000/api/users
# Content-Type: application/json
# 
#   {
#     "user": "Maxine Shaw",
#     "age": 30,
#     "height": 65,
#     "weight": 150,
#     "fitness": "Athletic"
#   }


